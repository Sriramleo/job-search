# Frontend Environment Configuration
# Germany Job Hunt Recruitment OS - Cloudflare Pages + FastAPI Backend

# Set VITE_API_BASE_URL to connect to the FastAPI backend
# Local Development:
# VITE_API_BASE_URL=http://localhost:8000
# Production Cloudflare Pages (e.g. deployed to https://jobsearch.sriramdevops.site):
# VITE_API_BASE_URL=https://api-jobsearch.sriramdevops.site
#
# If left blank, frontend safely falls back to local in-memory mock store for preview/demo
VITE_API_BASE_URL=https://api-jobsearch.sriramdevops.site
